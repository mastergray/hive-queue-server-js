{
  "name": "hive-queue-server",
  "version": "0.1.0",
  "description": "A minimalist HTTP server built on hive-queue: every request is a task, every stage is a worker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "run-s check:src check:tests",
    "check:src": "tsc --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json",
    "clean": "node scripts/clean-dist.mjs",
    "compile": "tsc",
    "compile:package": "tsc -p tsconfig.package.json",
    "build": "run-s clean compile",
    "build:package": "run-s clean compile:package",
    "prepare": "npm run build:package",
    "test": "node --import tsx tests/run.ts spec",
    "test:spec": "node --import tsx tests/run.ts spec",
    "test:live": "node --import tsx tests/run.ts live"
  },
  "keywords": [
    "server",
    "http",
    "queue",
    "worker",
    "chainable"
  ],
  "author": "mastergray",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastergray/hive-queue-server-js.git"
  },
  "homepage": "https://github.com/mastergray/hive-queue-server-js#readme",
  "bugs": "https://github.com/mastergray/hive-queue-server-js/issues",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "hive-queue": "github:mastergray/hive-queue-js#v0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ctg-js-test": "github:claymoretechgroup/ctg-js-test#v4.0.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
